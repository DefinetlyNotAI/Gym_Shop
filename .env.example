# local | test | preview | production
APP_ENV=local
SIM_MODE=0

# Runtime application role. Use a Neon pooled URL (-pooler hostname).
DATABASE_URL=postgresql://gym_shop_app:replace-me@example-pooler.neon.tech/gym_shop?sslmode=require

# Migration-owner role. Never expose this value to the browser or normal runtime.
DATABASE_OWNER_URL=postgresql://gym_shop_migrator:replace-me@example.neon.tech/gym_shop?sslmode=require

STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
API_ORIGIN=http://localhost:3001

# Vercel sends this as an Authorization bearer token to cron routes.
CRON_SECRET=replace-with-at-least-32-random-characters
OUTBOX_BATCH_SIZE=25

# Identity/security deployment values.
CTO_OWNER_EMAIL=owner@example.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Gym Shop
APS_ENVIRONMENT=sandbox
APS_ACCESS_CODE=replace-with-merchant-access-code
APS_MERCHANT_IDENTIFIER=replace-with-merchant-identifier
APS_SHA_REQUEST_PHRASE=replace-with-private-request-phrase
APS_SHA_RESPONSE_PHRASE=replace-with-private-response-phrase

# Business-owned adapter endpoint for approved email and WhatsApp providers.
NOTIFICATION_PROVIDER_API_URL=https://messaging-gateway.example.com
NOTIFICATION_PROVIDER_API_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_FROM_EMAIL=orders@example.com
SECURITY_ALERT_EMAIL=security-owner@example.com

# 32 random bytes encoded as base64url; encrypts one-use delivery material at rest.
OUTBOUND_SECRET_KEY=replace-with-32-random-bytes-base64url

# Server-side CAPTCHA verification adapter used by public CTO recovery.
CAPTCHA_VERIFY_URL=https://captcha-gateway.example.com/v1/verify
CAPTCHA_API_TOKEN=replace-with-at-least-32-random-characters

# Cloudflare R2 private/public object storage (S3-compatible endpoint).
# Mirror the endpoint and public base URL (never the credentials) to both UI
# deployments so their CSPs allow only these exact upload/media origins.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=gym-shop
R2_PUBLIC_BASE_URL=https://media.example.com
MEDIA_SCAN_SECRET=replace-with-at-least-32-random-characters
